node_modules/
dist/
# hub.sh assembles dist/hub inside a throwaway node container, where pnpm's store lands beside the
# checkout rather than in a home directory it does not have. Keeping it is deliberate: hub.sh
# rebuilds the bundle on every run so a re-run after `git pull` can never serve the previous
# revision, and a warm store is what keeps that from being a full download each time.
.pnpm-store/
.turbo/
.env
.env.*
!.env.example
.DS_Store
*.local
*.tsbuildinfo
.tanstack/

# Cargo's build output for apps/mesh, including the release script's per-output target directories.
apps/mesh/target/

# Wrangler: local secrets (never commit), local state and the dry-run bundle.
.dev.vars
.wrangler/
dist-cloudflare/
# Generated from convex/ by the backend's build:cloudflare, dev:cloudflare and deploy:cloudflare.
packages/backend/cloudflare/modules.generated.ts
