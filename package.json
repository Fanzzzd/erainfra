{
  "name": "erainfra",
  "version": "0.2.0-rc.24",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:backend": "turbo run dev --filter=@erainfra/backend",
    "dev:dashboard": "turbo run dev --filter=@erainfra/dashboard",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "codegen": "turbo run codegen",
    "convex": "pnpm --filter @erainfra/backend exec convex",
    "deploy:control-plane": "pnpm --filter @erainfra/backend run deploy",
    "release:package": "pnpm --filter @erainfra/release build-go-assets && turbo run build --filter=@erainfra/agent && pnpm --filter @erainfra/release package-agent",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check:structure": "node scripts/check-structure.mjs",
    "check": "pnpm lint && pnpm format:check && pnpm check:structure && pnpm typecheck && pnpm test",
    "changeset": "changeset",
    "release:version": "changeset version && node --experimental-strip-types packages/release/bin/sync-product-version.ts"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2007",
    "turbo": "2.11.10",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@12.18.0"
}
