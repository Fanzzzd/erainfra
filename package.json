{
  "name": "erainfra",
  "version": "0.2.0-rc.13",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:backend": "turbo run dev --filter=@erainfra/backend",
    "dev:dashboard": "turbo run dev --filter=@erainfra/dashboard",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "codegen": "turbo run codegen",
    "convex": "pnpm --filter @erainfra/backend exec convex",
    "deploy:control-plane": "pnpm --filter @erainfra/backend run deploy",
    "bundle:hub": "sh deploy/infra/build-hub-bundle.sh",
    "release:package": "pnpm --filter @erainfra/release build-go-assets && turbo run build --filter=@erainfra/agent && pnpm --filter @erainfra/release package-agent",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "turbo": "2.11.10",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.21.0"
}
