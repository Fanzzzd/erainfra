{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "arrowParens": "always",
  "bracketSpacing": true,
  "endOfLine": "lf",
  "objectWrap": "preserve",
  "proseWrap": "preserve",
  "ignorePatterns": [
    "**/_generated/**",
    "**/routeTree.gen.ts",
    "apps/erainfra-cli/internal/runsonmigrate/testdata/**"
  ]
}
