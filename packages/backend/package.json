{
  "name": "@erainfra/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./api": {
      "types": "./convex/_generated/api.d.ts",
      "default": "./convex/_generated/api.js"
    },
    "./dataModel": {
      "types": "./convex/_generated/dataModel.d.ts"
    },
    "./authPolicy": "./convex/authPolicy.ts",
    "./catalog": "./convex/catalog.ts",
    "./controllerLiveness": "./convex/controllerLiveness.ts",
    "./githubAppConfig": "./convex/githubAppConfig.ts"
  },
  "scripts": {
    "dev": "convex dev",
    "codegen": "convex codegen",
    "test": "vitest run",
    "typecheck": "tsc -p convex/tsconfig.json --noEmit && tsc -p tsconfig.json --noEmit",
    "deploy": "static-hosting deploy --dist ../../apps/dashboard/dist --build-command \"pnpm --filter @erainfra/dashboard build\"",
    "print-install-script": "node --experimental-strip-types scripts/print-install-script.ts",
    "print-infra-agent-pin": "node --experimental-strip-types scripts/print-infra-agent-pin.ts",
    "print-cache-service-pin": "node --experimental-strip-types scripts/print-cache-service-pin.ts",
    "print-controller-pin": "node --experimental-strip-types scripts/print-controller-pin.ts",
    "print-mesh-pin": "node --experimental-strip-types scripts/print-mesh-pin.ts",
    "embed-firecracker-provisioner": "node --experimental-strip-types scripts/embed-firecracker-provisioner.ts",
    "embed-controller-unit": "node --experimental-strip-types scripts/embed-controller-unit.ts",
    "import-hub-state": "node --experimental-strip-types scripts/import-hub-state.ts"
  },
  "dependencies": {
    "@auth/core": "0.41.3",
    "@convex-dev/auth": "0.0.94",
    "@convex-dev/static-hosting": "0.2.1",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "convex": "catalog:",
    "octokit": "5.0.5"
  },
  "devDependencies": {
    "@edge-runtime/vm": "5.0.0",
    "@erainfra/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "convex-test": "0.0.55",
    "typescript": "catalog:",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
