[Unit]
Description=EraInfra ephemeral GitHub runner
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service
# Start rate limiting belongs to the unit, not the service. systemd ignores
# these keys in [Service] and says so on the guest console at every boot.
StartLimitIntervalSec=30s
StartLimitBurst=5

[Service]
Type=simple
User=root
ExecStart=/usr/local/bin/runner-center-guest
Restart=on-failure
RestartSec=2s
# No Environment= lines, deliberately: runner-center-guest builds the runner's
# environment from nothing (runnerEnv in its main_linux.go), so a value set
# here never reaches a job. #110 measured exactly that -- LANG stated on this
# unit, unset in every job. The one environment a job gets is written where a
# test can read it, in the binary this unit starts.
#
# The runner inherits this service's resource limits, and it is a .NET
# process: at startup the runtime raises its soft fd limit to the hard limit,
# so whatever hard ceiling this line grants BECOMES every job's soft limit.
# #99's Docker-path decision (65536 soft, 1048576 hard as raisable headroom)
# died on that fact -- the first conformance run against it measured
# soft=1048576 in the job, exactly the fd-range-walking stall the soft limit
# was chosen to prevent. 65536 for both is what ubuntu-latest grants, and
# parity, not headroom, is the promise.
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
