[Unit]
Description=EraInfra ephemeral GitHub runner
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service
# Start rate limiting belongs to the unit, not the service. systemd ignores
# these keys in [Service] and says so on the guest console at every boot.
StartLimitIntervalSec=30s
StartLimitBurst=5

[Service]
Type=simple
User=root
ExecStart=/usr/local/bin/runner-center-guest
Restart=on-failure
RestartSec=2s
Environment=AGENT_TOOLSDIRECTORY=/opt/hostedtoolcache
Environment=RUNNER_TOOL_CACHE=/opt/hostedtoolcache
# The system manager starts every unit from a clean environment block, so the
# image's own ENV never reaches a job through here. Without this line LANG is
# unset for every step the runner spawns, and glibc answers ANSI_X3.4-1968.
Environment=LANG=C.UTF-8

[Install]
WantedBy=multi-user.target
