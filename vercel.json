{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo no install needed",
  "buildCommand": "echo no build needed",
  "outputDirectory": "public",
  "functions": {
    "api/installer.js": { "includeFiles": "deploy/*.sh" }
  },
  "rewrites": [
    { "source": "/mesh-node.sh", "destination": "/api/installer?name=mesh-node.sh" },
    { "source": "/mesh-node.ps1", "destination": "/api/installer?name=mesh-node.ps1" },
    { "source": "/registry.sh", "destination": "/api/installer?name=registry.sh" },
    { "source": "/image.sh", "destination": "/api/installer?name=image.sh" }
  ]
}
