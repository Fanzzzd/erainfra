{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo skip-install (function uses only Node builtins)",
  "buildCommand": "echo skip-build (static public/ + api/ function only)",
  "outputDirectory": "public",
  "functions": {
    "api/installer.js": { "includeFiles": "deploy/*.sh" }
  },
  "rewrites": [
    { "source": "/mesh-node.sh", "destination": "/api/installer?name=mesh-node.sh" },
    { "source": "/registry.sh", "destination": "/api/installer?name=registry.sh" },
    { "source": "/image.sh", "destination": "/api/installer?name=image.sh" }
  ]
}
