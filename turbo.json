{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  // Tests in several packages read files that belong to no single package: the shared
  // case files in testdata/, the provisioner and units under deploy/ (embed hash tests),
  // and the runtime's golden test report. Turbo hashes a task against its own package's
  // files, so without these globs editing one of them would replay a cached green `test`
  // run that never saw the change.
  "globalDependencies": [
    "testdata/**",
    "deploy/**",
    "apps/runtime/internal/testreport/testdata/**"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "env": ["VITE_*"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "codegen": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
