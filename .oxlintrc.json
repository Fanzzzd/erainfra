{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "promise", "react"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "warn"
  },
  "env": {
    "builtin": true,
    "es2024": true
  },
  "ignorePatterns": ["**/_generated/**", "**/routeTree.gen.ts", "**/.tanstack/**"],
  "rules": {
    "import/no-cycle": "error",
    // `boot-env.ts` exists only for its side effect: it sets the durable-state env
    // defaults that must be in place before router.ts constructs its singletons.
    // Assigning the import would be the thing that is wrong, not the import.
    "import/no-unassigned-import": ["error", { "allow": ["**/*.css", "**/boot-env.ts"] }],
    "no-console": "off",
    // Convex mutations are transactional: sequential awaits are intended.
    "no-await-in-loop": "off",
    // Query results are reshaped by spreading to drop secrets (machine tokens)
    // and add derived fields; the rows are few and the copy is deliberate.
    "oxc/no-map-spread": "off",
    // Convex documents expose `_id` / `_creationTime`.
    "no-underscore-dangle": "off",
    // React 19 automatic JSX runtime — no `React` import needed.
    "react/react-in-jsx-scope": "off"
  },
  "overrides": [
    {
      "files": ["apps/dashboard/**", "apps/hub-web/**", "apps/docs/**"],
      "env": { "browser": true }
    },
    {
      "files": [
        ".github/probes/**",
        "apps/action-runner-agent/**",
        "apps/hub/**",
        "packages/backend/scripts/**",
        "packages/backend/tests/**",
        "packages/cli/**",
        "packages/release/**"
      ],
      "env": { "node": true }
    },
    {
      // A helper declared inside a describe block sits next to the only tests that use it. The
      // rule's reason, not recreating a function on every call, does not apply: a describe body
      // runs once.
      "files": ["**/tests/**", "**/test/**", "**/*.test.*"],
      "rules": { "unicorn/consistent-function-scoping": "off" }
    },
    {
      // The Hub's web app is retired (docs/runbooks/retire-the-hub.md) and kept only as the
      // rollback source, so its behaviour is frozen. These two React Compiler rules, new in
      // oxlint 1.90, flag its polling refreshes, its default-select effects and a
      // location.hash write in a click handler. Rewriting them would change a UI nobody runs
      // any more for no gain. The live dashboard keeps both rules.
      "files": ["apps/hub-web/**"],
      "rules": { "react/set-state-in-effect": "off", "react/immutability": "off" }
    }
  ]
}
