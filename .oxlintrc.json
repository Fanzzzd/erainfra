{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "promise", "react"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "warn"
  },
  "options": {
    "reportUnusedDisableDirectives": "error",
    "typeAware": true
  },
  "env": {
    "builtin": true,
    "es2024": true
  },
  "ignorePatterns": ["**/_generated/**", "**/routeTree.gen.ts", "**/.tanstack/**"],
  "rules": {
    "import/no-cycle": "error",
    // `boot-env.ts` exists only for its side effect: it sets the durable-state env
    // defaults that must be in place before router.ts constructs its singletons.
    // Assigning the import would be the thing that is wrong, not the import.
    "import/no-unassigned-import": ["error", { "allow": ["**/*.css", "**/boot-env.ts"] }],
    "no-console": "off",
    // Convex mutations are transactional: sequential awaits are intended.
    "no-await-in-loop": "off",
    // Query results are reshaped by spreading to drop secrets (machine tokens)
    // and add derived fields; the rows are few and the copy is deliberate.
    "oxc/no-map-spread": "off",
    // Convex documents expose `_id` / `_creationTime`.
    "no-underscore-dangle": "off",
    // React 19 automatic JSX runtime — no `React` import needed.
    "react/react-in-jsx-scope": "off",

    // Type-aware rules. tsgolint runs them because options.typeAware is true.
    // The correctness and suspicious categories enable the rest of them.
    "typescript/no-floating-promises": [
      "error",
      {
        "allowForKnownSafeCalls": [
          {
            "from": "package",
            "package": "node:test",
            "name": ["test", "describe", "it", "suite"]
          }
        ]
      }
    ],
    "typescript/no-misused-promises": "error",
    "typescript/no-mixed-enums": "error",
    "typescript/only-throw-error": [
      "error",
      { "allowRethrowing": true, "allowThrowingUnknown": true }
    ],
    "typescript/prefer-promise-reject-errors": [
      "error",
      { "allowThrowingAny": true, "allowThrowingUnknown": true }
    ],
    "typescript/require-array-sort-compare": ["error", { "ignoreStringArrays": true }],
    "typescript/restrict-plus-operands": "error",
    "typescript/restrict-template-expressions": ["error", { "allowNever": true }],
    "typescript/return-await": ["error", "in-try-catch"],
    "typescript/switch-exhaustiveness-check": [
      "error",
      { "considerDefaultExhaustiveForUnions": true }
    ],
    // 9 hits, none real: exhaustive switches that TypeScript already checks, and one effect that
    // returns a cleanup only when it subscribes.
    "typescript/consistent-return": "off",
    // 16 hits, none real: FormData text fields and test fetch doubles that receive strings.
    "typescript/no-base-to-string": "off",
    // 18 hits, none real: `ok === false` narrows a result union inside a test assertion.
    "typescript/no-unnecessary-boolean-literal-compare": "off",
    // 4 hits, none real: String() guards an env value or a caught error whose runtime value can be
    // undefined despite its declared type.
    "typescript/no-unnecessary-type-conversion": "off",
    // 338 hits: request decoders, Convex documents and test doubles assert by design.
    "typescript/no-unsafe-type-assertion": "off"
  },
  "overrides": [
    {
      "files": ["apps/dashboard/**"],
      "env": { "browser": true }
    },
    {
      "files": [
        ".github/probes/**",
        "apps/action-runner-agent/**",
        "packages/backend/scripts/**",
        "packages/backend/tests/**",
        "packages/release/**"
      ],
      "env": { "node": true }
    },
    {
      // A helper declared inside a describe block sits next to the only tests that use it. The
      // rule's reason, not recreating a function on every call, does not apply: a describe body
      // runs once.
      "files": ["**/tests/**", "**/test/**", "**/*.test.*"],
      "rules": { "unicorn/consistent-function-scoping": "off" }
    }
  ]
}
