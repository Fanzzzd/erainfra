[Unit]
Description=Runner Center privileged Firecracker runtime
Documentation=https://github.com/Fanzzzd/runner-center
# The Runner Center runtime talks to its own containerd, not whatever else the
# host runs. Naming the host's containerd.service here would start the runtime
# before its snapshotter exists on a Docker host, and refuse to start at all on
# a host that has no unit by that name.
Requires=runner-center-containerd.service
After=runner-center-containerd.service network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
EnvironmentFile=-/etc/runner-center/runtime.env
Environment=RC_RUNTIME_GROUP=runner-center
ExecStart=/usr/local/lib/runner-center/runner-center-runtime serve
Restart=on-failure
RestartSec=5s
KillMode=control-group
TimeoutStopSec=45s
UMask=0077
RuntimeDirectory=runner-center
StateDirectory=runner-center
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
LimitNOFILE=1048576
# Explicit host-side process admission. A guest cannot exhaust host PIDs across
# the VM boundary, but the runtime's own VMM and CNI processes are bounded here
# so one Worker can never starve the machine.
TasksMax=8192

[Install]
WantedBy=multi-user.target
