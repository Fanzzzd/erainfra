  "extends": "@erainfra/typescript-config/react.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "allowJs": false,
    "types": ["node", "vite/client"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"]
}
