{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "rootDir": ".",
    "outDir": "dist",
    "strict": true,
    "skipLibCheck": true,
    "noEmitOnError": true,
    "types": ["node"],
    "sourceMap": true
  },
  "include": ["index.ts", "config.ts", "provision.ts"]
}
