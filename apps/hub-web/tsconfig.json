{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@erainfra/typescript-config/react.json",
  "compilerOptions": {
    // Vite, not Node, resolves this tree, so the ambient types it needs are its own
    // (`import.meta.env`, `?raw` imports). Narrowing `types` also keeps @types/node from
    // leaking in through the workspace and making `process` look available in the browser.
    "types": ["vite/client"],
    // The `@/…` specifier is written into every component import and into
    // components.json, which is what the shadcn generator reads when it adds a new one.
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src"]
}
